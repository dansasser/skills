{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-envelope.schema.json",
  "title": "Graph Development V3 Context Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "mode",
    "graph",
    "task_node_id",
    "execution_context",
    "budget",
    "manifest",
    "payload",
    "selection",
    "request_policy",
    "parent_request_digest",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "envelope_id": {"$ref": "#/$defs/slug"},
    "mode": {"enum": ["preview", "executable"]},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_id",
        "graph_version",
        "context_version",
        "canonical_sha256"
      ],
      "properties": {
        "graph_id": {"$ref": "#/$defs/slug"},
        "graph_version": {"type": "integer", "minimum": 1},
        "context_version": {"type": "string", "minLength": 1},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task_node_id": {"$ref": "#/$defs/slug"},
    "execution_context": {"$ref": "#/$defs/executionContext"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_limit",
        "output_reserve",
        "safety_margin",
        "available_context",
        "used_context",
        "fixed_tokens",
        "capability_schema_tokens",
        "mandatory_tokens",
        "optional_tokens",
        "dynamic_tokens",
        "tokenizer"
      ],
      "properties": {
        "input_limit": {"type": "integer", "minimum": 1},
        "output_reserve": {"type": "integer", "minimum": 0},
        "safety_margin": {"type": "integer", "minimum": 0},
        "available_context": {"type": "integer", "minimum": 0},
        "used_context": {"type": "integer", "minimum": 0},
        "fixed_tokens": {"type": "integer", "minimum": 0},
        "capability_schema_tokens": {"type": "integer", "minimum": 0},
        "mandatory_tokens": {"type": "integer", "minimum": 0},
        "optional_tokens": {"type": "integer", "minimum": 0},
        "dynamic_tokens": {"type": "integer", "minimum": 0},
        "tokenizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "exact"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "exact": {"type": "boolean"}
          }
        }
      }
    },
    "manifest": {
      "type": "array",
      "items": {"$ref": "#/$defs/manifestItem"}
    },
    "payload": {
      "type": "array",
      "items": {"$ref": "#/$defs/payloadItem"}
    },
    "selection": {"$ref": "#/$defs/selection"},
    "request_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_kinds",
        "allowed_capabilities",
        "max_additional_tokens"
      ],
      "properties": {
        "allowed_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["context", "artifact", "action"]}
        },
        "allowed_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slug"}
        },
        "max_additional_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "parent_request_digest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "executable"}}},
      "then": {
        "properties": {
          "budget": {
            "properties": {
              "tokenizer": {
                "properties": {"exact": {"const": true}}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_version",
        "classification",
        "inclusion_class",
        "inclusion_reason",
        "token_count",
        "sha256",
        "source",
        "requirements"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "string", "minLength": 1},
        "classification": {"enum": ["mandatory", "optional"]},
        "inclusion_class": {
          "enum": [
            "node_contract",
            "direct_input",
            "policy",
            "authority",
            "approval",
            "safety",
            "invalidation",
            "capability",
            "optional"
          ]
        },
        "inclusion_reason": {"type": "string", "minLength": 1},
        "token_count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source": {"type": "string", "minLength": 1},
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "payloadItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "content": {"type": "string"}
      }
    },
    "executionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "node_contract_digest",
        "adapter_identity",
        "selector_version",
        "compactor_version"
      ],
      "properties": {
        "checkpoint_id": {"type": "string", "minLength": 1},
        "node_contract_digest": {"$ref": "#/$defs/sha256"},
        "adapter_identity": {"type": "string", "minLength": 1},
        "selector_version": {"type": "string", "minLength": 1},
        "compactor_version": {"type": "string", "minLength": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_version",
        "strategy",
        "selected_ids",
        "omitted",
        "trace",
        "covered_requirements",
        "utility",
        "used_tokens",
        "budget"
      ],
      "properties": {
        "selector_version": {"type": "string", "minLength": 1},
        "strategy": {"type": "string", "minLength": 1},
        "selected_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "omitted": {
          "type": "array",
          "items": {"$ref": "#/$defs/omission"}
        },
        "trace": {"type": "array", "items": {"type": "object"}},
        "covered_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "utility": {"type": "number", "minimum": 0},
        "used_tokens": {"type": "integer", "minimum": 0},
        "budget": {"type": "integer", "minimum": 0}
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "reason", "token_count"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "token_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
