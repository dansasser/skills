{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-request.schema.json",
  "title": "Graph Development V3 Context Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "envelope_id",
    "task_node_id",
    "kind",
    "purpose",
    "max_tokens",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"$ref": "#/$defs/slug"},
    "envelope_id": {"$ref": "#/$defs/slug"},
    "task_node_id": {"$ref": "#/$defs/slug"},
    "kind": {"enum": ["context", "artifact", "action"]},
    "purpose": {"type": "string", "minLength": 1},
    "max_tokens": {"type": "integer", "minimum": 0},
    "requested_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "capability": {"$ref": "#/$defs/slug"},
    "arguments": {"type": "object"},
    "digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {"enum": ["context", "artifact"]}
        }
      },
      "then": {"required": ["requested_artifacts"]}
    },
    {
      "if": {"properties": {"kind": {"const": "action"}}},
      "then": {"required": ["capability", "arguments"]}
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
