{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-result.schema.json",
  "title": "Graph Development V3 Context Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "task_node_id",
    "status",
    "usage",
    "provenance",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "envelope_id": {"$ref": "#/$defs/slug"},
    "task_node_id": {"$ref": "#/$defs/slug"},
    "status": {
      "enum": [
        "completed",
        "context_request",
        "action_request",
        "mandatory_overflow",
        "policy_denied",
        "invalid_envelope",
        "adapter_failure",
        "cancelled"
      ]
    },
    "output_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "result_payload": {
      "type": ["object", "array", "string", "number", "boolean", "null"]
    },
    "request": {"$ref": "context-request.schema.json"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "sha256"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "error": {"type": "string", "minLength": 1},
    "digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {"required": ["result_payload", "output_artifacts"]}
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["context_request", "action_request"]}
        }
      },
      "then": {"required": ["request"]}
    },
    {
      "if": {"properties": {"status": {"const": "context_request"}}},
      "then": {
        "properties": {
          "request": {
            "properties": {
              "kind": {"enum": ["context", "artifact"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "action_request"}}},
      "then": {
        "properties": {
          "request": {
            "properties": {"kind": {"const": "action"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "mandatory_overflow",
              "policy_denied",
              "invalid_envelope",
              "adapter_failure",
              "cancelled"
            ]
          }
        }
      },
      "then": {"required": ["error"]}
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
