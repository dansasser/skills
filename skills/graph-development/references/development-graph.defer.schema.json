{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/graph-development/development-graph.defer.schema.json",
  "title": "Development Graph Finding Deferral",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deferral_id",
    "target_run_id",
    "expected_run_version",
    "expected_outcome_contract_digest",
    "expected_graph_version",
    "expected_graph_checksum",
    "expected_projection_checksum",
    "causal_episode_id",
    "finding_id",
    "reason",
    "evidence",
    "actor",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "deferral_id": {
      "$ref": "#/$defs/slug"
    },
    "target_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_run_version": {
      "type": "integer",
      "minimum": 1
    },
    "expected_outcome_contract_digest": {
      "$ref": "#/$defs/checksum"
    },
    "expected_graph_version": {
      "type": "integer",
      "minimum": 1
    },
    "expected_graph_checksum": {
      "$ref": "#/$defs/checksum"
    },
    "expected_projection_checksum": {
      "$ref": "#/$defs/checksum"
    },
    "causal_episode_id": {
      "$ref": "#/$defs/slug"
    },
    "finding_id": {
      "$ref": "#/$defs/slug"
    },
    "reason": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "actor": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "authority": {
      "$ref": "#/$defs/nonEmptyString"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slugList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "mappings": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "additionalProperties": {
        "$ref": "#/$defs/slugList"
      }
    }
  }
}
