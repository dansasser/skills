{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/graph-development/development-graph.invalidation.schema.json",
  "title": "Development Graph Semantic Invalidation Request",
  "description": "Preview-first semantic invalidation bound to one projected run and exact impact authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invalidation_id",
    "causal_episode_id",
    "target_run_id",
    "expected_run_version",
    "expected_outcome_contract_digest",
    "expected_graph_version",
    "expected_graph_checksum",
    "expected_projection_checksum",
    "node_ids",
    "artifact_changes",
    "reason",
    "actor",
    "authority",
    "authority_evidence",
    "impact_gate",
    "episode_gate"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "invalidation_id": {
      "$ref": "#/$defs/slug"
    },
    "causal_episode_id": {
      "$ref": "#/$defs/slug"
    },
    "target_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_run_version": {
      "type": "integer",
      "minimum": 1
    },
    "expected_outcome_contract_digest": {
      "$ref": "#/$defs/checksum"
    },
    "expected_graph_version": {
      "type": "integer",
      "minimum": 1
    },
    "expected_graph_checksum": {
      "$ref": "#/$defs/checksum"
    },
    "expected_projection_checksum": {
      "$ref": "#/$defs/checksum"
    },
    "node_ids": {
      "$ref": "#/$defs/slugList"
    },
    "artifact_changes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactChange"
      }
    },
    "reason": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "actor": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "authority": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "authority_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "impact_gate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/impactGate"
        }
      ]
    },
    "episode_gate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/episodeGate"
        }
      ]
    }
  },
  "anyOf": [
    {
      "properties": {
        "node_ids": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "artifact_changes": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slugList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "artifactChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "previous_digest",
        "current_digest"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "previous_digest": {
          "$ref": "#/$defs/checksum"
        },
        "current_digest": {
          "$ref": "#/$defs/checksum"
        }
      }
    },
    "impactGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "run_id",
        "impact_digest",
        "approver",
        "gate_node_id",
        "evidence_digest",
        "approved_at"
      ],
      "properties": {
        "decision": {
          "const": "approved"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "impact_digest": {
          "$ref": "#/$defs/checksum"
        },
        "approver": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "gate_node_id": {
          "$ref": "#/$defs/slug"
        },
        "evidence_digest": {
          "$ref": "#/$defs/checksum"
        },
        "approved_at": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "episodeGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "run_id",
        "causal_episode_id",
        "episode_operation_digest",
        "approver",
        "evidence_digest",
        "approved_at"
      ],
      "properties": {
        "decision": {
          "enum": [
            "authorize-next-cycle",
            "approve-independent-episode"
          ]
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "causal_episode_id": {
          "$ref": "#/$defs/slug"
        },
        "episode_operation_digest": {
          "$ref": "#/$defs/checksum"
        },
        "approver": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_digest": {
          "$ref": "#/$defs/checksum"
        },
        "approved_at": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
