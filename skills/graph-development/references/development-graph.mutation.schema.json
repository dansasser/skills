{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/graph-development/development-graph.mutation.schema.json",
  "title": "Governed Development Graph Mutation",
  "oneOf": [
    {
      "$ref": "#/$defs/version1"
    },
    {
      "$ref": "#/$defs/version2Record"
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "approver",
            "evidence",
            "graph_checksum"
          ],
          "properties": {
            "decision": {
              "const": "approved"
            },
            "approver": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "evidence": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "graph_checksum": {
              "$ref": "#/$defs/checksum"
            }
          }
        }
      ]
    },
    "valueOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "id",
        "value"
      ],
      "properties": {
        "op": {
          "enum": [
            "add-node",
            "replace-node",
            "add-edge",
            "replace-edge"
          ]
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "value": {
          "type": "object"
        }
      }
    },
    "removeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "id"
      ],
      "properties": {
        "op": {
          "enum": [
            "remove-node",
            "remove-edge"
          ]
        },
        "id": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "rootOperationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "field",
        "value"
      ],
      "properties": {
        "op": {
          "const": "update-root"
        },
        "field": {
          "enum": [
            "title",
            "purpose",
            "status",
            "templates",
            "assumptions",
            "risks"
          ]
        },
        "value": {}
      }
    },
    "rootOperationV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "field",
        "value"
      ],
      "properties": {
        "op": {
          "const": "update-root"
        },
        "field": {
          "enum": [
            "title",
            "purpose",
            "status",
            "templates",
            "assumptions",
            "risks",
            "entry_nodes",
            "terminal_nodes"
          ]
        },
        "value": {}
      }
    },
    "operationsV1": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/valueOperation"
          },
          {
            "$ref": "#/$defs/removeOperation"
          },
          {
            "$ref": "#/$defs/rootOperationV1"
          }
        ]
      }
    },
    "operationsV2": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/valueOperation"
          },
          {
            "$ref": "#/$defs/removeOperation"
          },
          {
            "$ref": "#/$defs/rootOperationV2"
          }
        ]
      }
    },
    "invalidateV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "artifacts"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "invalidateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "artifacts"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "maxItems": 0
        },
        "artifacts": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "version1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mutation_id",
        "rationale",
        "evidence",
        "expected_graph_version",
        "expected_graph_checksum",
        "new_context_version",
        "operations",
        "invalidate",
        "approval"
      ],
      "properties": {
        "mutation_id": {
          "$ref": "#/$defs/slug"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "expected_graph_version": {
          "type": "integer",
          "minimum": 1
        },
        "expected_graph_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "new_context_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "schema_version": {
          "const": 1
        },
        "operations": {
          "$ref": "#/$defs/operationsV1"
        },
        "invalidate": {
          "$ref": "#/$defs/invalidateV1"
        }
      }
    },
    "version2Record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mutation_id",
        "rationale",
        "evidence",
        "expected_graph_version",
        "expected_graph_checksum",
        "new_context_version",
        "operations",
        "invalidate",
        "approval",
        "runtime_effect",
        "expected_run_version",
        "causal_episode_id",
        "episode_effect",
        "episode_gate"
      ],
      "properties": {
        "mutation_id": {
          "$ref": "#/$defs/slug"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "expected_graph_version": {
          "type": "integer",
          "minimum": 1
        },
        "expected_graph_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "new_context_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "schema_version": {
          "const": 2
        },
        "runtime_effect": {
          "const": "record-only"
        },
        "expected_run_version": {
          "type": "integer",
          "minimum": 1
        },
        "operations": {
          "$ref": "#/$defs/operationsV2"
        },
        "invalidate": {
          "$ref": "#/$defs/invalidateRecord"
        },
        "causal_episode_id": {
          "$ref": "#/$defs/slug"
        },
        "episode_effect": {
          "enum": [
            "observe-only",
            "repair-cycle"
          ]
        },
        "episode_gate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/episodeGate"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "episode_effect": {
                "const": "observe-only"
              }
            },
            "required": [
              "episode_effect"
            ]
          },
          "then": {
            "properties": {
              "episode_gate": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "episodeGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "run_id",
        "causal_episode_id",
        "episode_operation_digest",
        "approver",
        "evidence_digest",
        "approved_at"
      ],
      "properties": {
        "decision": {
          "enum": [
            "authorize-next-cycle",
            "approve-independent-episode"
          ]
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "causal_episode_id": {
          "$ref": "#/$defs/slug"
        },
        "episode_operation_digest": {
          "$ref": "#/$defs/checksum"
        },
        "approver": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_digest": {
          "$ref": "#/$defs/checksum"
        },
        "approved_at": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
