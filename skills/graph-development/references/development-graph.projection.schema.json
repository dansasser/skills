{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/graph-development/development-graph.projection.schema.json",
  "title": "Development Graph Run Projection",
  "description": "Immutable execution projection bound to one outcome contract and durable graph revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "graph_id",
    "source_graph_version",
    "source_graph_checksum",
    "contract_id",
    "contract_version",
    "projection_version",
    "nodes",
    "edges",
    "entry_nodes",
    "terminal_nodes",
    "semantic_dependencies",
    "requirement_mappings",
    "acceptance_mappings",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "graph_id": {
      "$ref": "development-graph.schema.json#/$defs/slug"
    },
    "source_graph_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_graph_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_id": {
      "$ref": "development-graph.schema.json#/$defs/slug"
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "projection_version": {
      "type": "integer",
      "minimum": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "development-graph.schema.json#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "development-graph.schema.json#/$defs/edge"
      }
    },
    "entry_nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "development-graph.schema.json#/$defs/slug"
      }
    },
    "terminal_nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "development-graph.schema.json#/$defs/slug"
      }
    },
    "semantic_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "rationale"
        ],
        "properties": {
          "id": {
            "$ref": "development-graph.schema.json#/$defs/slug"
          },
          "from": {
            "$ref": "development-graph.schema.json#/$defs/slug"
          },
          "to": {
            "$ref": "development-graph.schema.json#/$defs/slug"
          },
          "rationale": {
            "$ref": "development-graph.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "requirement_mappings": {
      "$ref": "#/$defs/mappings"
    },
    "acceptance_mappings": {
      "$ref": "#/$defs/mappings"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "authority"
      ],
      "properties": {
        "actor": {
          "$ref": "development-graph.schema.json#/$defs/nonEmptyString"
        },
        "authority": {
          "$ref": "development-graph.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_path",
        "parent_checksum",
        "parent_version",
        "promotion_id",
        "added_node_ids",
        "added_edge_ids"
      ],
      "properties": {
        "parent_path": {
          "$ref": "development-graph.schema.json#/$defs/nonEmptyString"
        },
        "parent_checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parent_version": {
          "type": "integer",
          "minimum": 1
        },
        "promotion_id": {
          "$ref": "development-graph.schema.json#/$defs/slug"
        },
        "added_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "development-graph.schema.json#/$defs/slug"
          }
        },
        "added_edge_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "development-graph.schema.json#/$defs/slug"
          }
        }
      }
    }
  },
  "$defs": {
    "mappings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "development-graph.schema.json#/$defs/nonEmptyString"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "development-graph.schema.json#/$defs/slug"
        }
      }
    }
  }
}
