{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/graph-development/development-graph.promotion.schema.json",
  "title": "Development Graph Run Promotion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "promotion_id",
    "causal_episode_id",
    "target_run_id",
    "expected_run_version",
    "expected_outcome_contract_digest",
    "expected_graph_version",
    "expected_graph_checksum",
    "expected_projection_checksum",
    "classification",
    "node_ids",
    "edge_ids",
    "requirement_mappings",
    "acceptance_mappings",
    "semantic_invalidation",
    "fanout_policy_result",
    "impact_gate",
    "actor",
    "authority",
    "authority_evidence",
    "rationale",
    "evidence",
    "episode_gate"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "promotion_id": {
      "$ref": "#/$defs/slug"
    },
    "causal_episode_id": {
      "$ref": "#/$defs/slug"
    },
    "target_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_run_version": {
      "type": "integer",
      "minimum": 1
    },
    "expected_outcome_contract_digest": {
      "$ref": "#/$defs/checksum"
    },
    "expected_graph_version": {
      "type": "integer",
      "minimum": 1
    },
    "expected_graph_checksum": {
      "$ref": "#/$defs/checksum"
    },
    "expected_projection_checksum": {
      "$ref": "#/$defs/checksum"
    },
    "classification": {
      "enum": [
        "existing-requirement",
        "current-regression",
        "approved-outcome-change",
        "deferred"
      ]
    },
    "node_ids": {
      "$ref": "#/$defs/slugList"
    },
    "edge_ids": {
      "$ref": "#/$defs/slugList"
    },
    "requirement_mappings": {
      "$ref": "#/$defs/mappings"
    },
    "acceptance_mappings": {
      "$ref": "#/$defs/mappings"
    },
    "semantic_invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "artifacts"
      ],
      "properties": {
        "nodes": {
          "$ref": "#/$defs/slugList"
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactChange"
          }
        }
      }
    },
    "fanout_policy_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "basis"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "basis": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "actor": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "authority": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "authority_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "rationale": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "impact_gate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/impactGate"
        }
      ]
    },
    "episode_gate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/episodeGate"
        }
      ]
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slugList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "mappings": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "additionalProperties": {
        "$ref": "#/$defs/slugList"
      }
    },
    "artifactChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "previous_digest",
        "current_digest"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "previous_digest": {
          "$ref": "#/$defs/checksum"
        },
        "current_digest": {
          "$ref": "#/$defs/checksum"
        }
      }
    },
    "impactGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "run_id",
        "impact_digest",
        "approver",
        "gate_node_id",
        "evidence_digest",
        "approved_at"
      ],
      "properties": {
        "decision": {
          "const": "approved"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "impact_digest": {
          "$ref": "#/$defs/checksum"
        },
        "approver": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "gate_node_id": {
          "$ref": "#/$defs/slug"
        },
        "evidence_digest": {
          "$ref": "#/$defs/checksum"
        },
        "approved_at": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "episodeGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "run_id",
        "causal_episode_id",
        "episode_operation_digest",
        "approver",
        "evidence_digest",
        "approved_at"
      ],
      "properties": {
        "decision": {
          "enum": [
            "authorize-next-cycle",
            "approve-independent-episode"
          ]
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "causal_episode_id": {
          "$ref": "#/$defs/slug"
        },
        "episode_operation_digest": {
          "$ref": "#/$defs/checksum"
        },
        "approver": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_digest": {
          "$ref": "#/$defs/checksum"
        },
        "approved_at": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "const": "existing-requirement"
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "semantic_invalidation": {
            "const": {
              "nodes": [],
              "artifacts": []
            }
          },
          "fanout_policy_result": {
            "properties": {
              "allowed": {
                "const": true
              }
            },
            "required": [
              "allowed"
            ]
          },
          "impact_gate": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "const": "current-regression"
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "semantic_invalidation": {
            "anyOf": [
              {
                "properties": {
                  "nodes": {
                    "minItems": 1
                  }
                },
                "required": [
                  "nodes"
                ]
              },
              {
                "properties": {
                  "artifacts": {
                    "minItems": 1
                  }
                },
                "required": [
                  "artifacts"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "enum": [
              "approved-outcome-change",
              "deferred"
            ]
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "semantic_invalidation": {
            "const": {
              "nodes": [],
              "artifacts": []
            }
          },
          "fanout_policy_result": {
            "properties": {
              "allowed": {
                "const": true
              }
            },
            "required": [
              "allowed"
            ]
          },
          "impact_gate": {
            "type": "null"
          }
        }
      }
    }
  ]
}
