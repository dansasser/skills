{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/graph-development/development-graph.schema.json",
  "title": "Project Development Graph",
  "description": "Canonical machine-readable contract for a project-specific software development lifecycle graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "graph_version",
    "title",
    "purpose",
    "project",
    "status",
    "templates",
    "entry_nodes",
    "terminal_nodes",
    "nodes",
    "edges",
    "assumptions",
    "risks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "graph_id": {"$ref": "#/$defs/slug"},
    "graph_version": {"type": "integer", "minimum": 1},
    "title": {"$ref": "#/$defs/nonEmptyString"},
    "purpose": {"$ref": "#/$defs/nonEmptyString"},
    "project": {"$ref": "#/$defs/project"},
    "status": {"enum": ["draft", "validated", "approved", "archived"]},
    "templates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    },
    "entry_nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    },
    "terminal_nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "risks": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root", "instructions", "context_version"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "root": {"$ref": "#/$defs/nonEmptyString"},
        "instructions": {"$ref": "#/$defs/stringArray"},
        "context_version": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "artifact", "required"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "artifact": {"$ref": "#/$defs/nonEmptyString"},
        "required": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "artifact", "format"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "artifact": {"$ref": "#/$defs/nonEmptyString"},
        "format": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "criterion", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["artifact", "test", "schema", "review", "policy", "probe", "manual"]},
        "criterion": {"$ref": "#/$defs/nonEmptyString"},
        "evidence": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "instructions"],
      "properties": {
        "kind": {"enum": ["deterministic", "agent", "human", "hybrid"]},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "instructions": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "external", "destructive"],
      "properties": {
        "read": {"$ref": "#/$defs/stringArray"},
        "write": {"$ref": "#/$defs/stringArray"},
        "external": {"$ref": "#/$defs/stringArray"},
        "destructive": {"type": "boolean"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "timeout_minutes", "completion_condition"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "timeout_minutes": {"type": "integer", "minimum": 1},
        "completion_condition": {"$ref": "#/$defs/nonEmptyString"},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "working_directory": {"$ref": "#/$defs/nonEmptyString"},
        "environment": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        },
        "evidence_paths": {"$ref": "#/$defs/stringArray"},
        "capture_limit_bytes": {"type": "integer", "minimum": 1024},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "contextControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "plan_path",
        "mode",
        "tokenizer",
        "adapter",
        "retention"
      ],
      "properties": {
        "version": {"const": 3},
        "plan_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "mode": {"enum": ["preview", "executable"]},
        "tokenizer": {"$ref": "#/$defs/nonEmptyString"},
        "adapter": {"$ref": "#/$defs/slug"},
        "retention": {"enum": ["digest-only", "explicit-payload"]}
      }
    },
    "sideEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "description", "rollback", "approval_required"],
      "properties": {
        "level": {"enum": ["none", "reversible", "destructive"]},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "rollback": {"$ref": "#/$defs/nonEmptyString"},
        "approval_required": {"type": "boolean"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "goal",
        "state",
        "executor",
        "inputs",
        "outputs",
        "acceptance",
        "permissions",
        "execution",
        "side_effects",
        "resources",
        "tags"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "type": {"enum": ["work", "decision", "verification", "human_gate", "operation", "observation"]},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "goal": {"$ref": "#/$defs/nonEmptyString"},
        "state": {"enum": ["planned", "ready", "blocked", "running", "verifying", "verified", "invalidated", "failed", "needs_human", "cancelled"]},
        "executor": {"$ref": "#/$defs/executor"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}},
        "acceptance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/acceptance"}},
        "permissions": {"$ref": "#/$defs/permissions"},
        "execution": {"$ref": "#/$defs/execution"},
        "context_control": {"$ref": "#/$defs/contextControl"},
        "side_effects": {"$ref": "#/$defs/sideEffects"},
        "resources": {"$ref": "#/$defs/stringArray"},
        "tags": {"$ref": "#/$defs/stringArray"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "type", "condition", "artifacts", "max_traversals", "exit_condition"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "from": {"$ref": "#/$defs/slug"},
        "to": {"$ref": "#/$defs/slug"},
        "type": {"enum": ["requires", "consumes", "validates", "approves", "blocks", "invalidates", "feedback", "conflicts"]},
        "condition": {"$ref": "#/$defs/nonEmptyString"},
        "artifacts": {"$ref": "#/$defs/stringArray"},
        "max_traversals": {"type": ["integer", "null"], "minimum": 1},
        "exit_condition": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonEmptyString"}
          ]
        }
      }
    }
  }
}
