{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/graph-development/project-template.schema.json",
  "title": "Graph Development project template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "entry_mode",
    "entry_nodes",
    "terminal_nodes",
    "nodes",
    "feedback",
    "approvals",
    "project_files",
    "specification"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "entry_mode": {
      "$ref": "#/$defs/slug"
    },
    "entry_nodes": {
      "$ref": "#/$defs/slugArray"
    },
    "terminal_nodes": {
      "$ref": "#/$defs/slugArray"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "feedback": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feedback"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "project_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectFile"
      }
    },
    "specification": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!~)(?!.*(?:^|/)\\.\\.(?:/|$))(?=.*\\S).+$"
    },
    "slugArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "writes",
        "destructive",
        "predecessors",
        "output",
        "write_scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "type": {
          "enum": [
            "operation",
            "work",
            "decision",
            "verification",
            "human_gate",
            "observation"
          ]
        },
        "writes": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "predecessors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact",
            "format"
          ],
          "properties": {
            "artifact": {
              "$ref": "#/$defs/nonempty"
            },
            "format": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        "write_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "max_traversals",
        "exit_condition"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/slug"
        },
        "to": {
          "$ref": "#/$defs/slug"
        },
        "max_traversals": {
          "type": "integer",
          "minimum": 1
        },
        "exit_condition": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "artifact"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/slug"
        },
        "to": {
          "$ref": "#/$defs/slug"
        },
        "artifact": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "projectFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "source": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  }
}
