{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/graph-development/specification-manifest.schema.json",
  "title": "Development specification manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "graph_version",
    "context_version",
    "specification_root",
    "documents",
    "decisions",
    "verification_node",
    "approval"
  ],
  "anyOf": [
    {"required": ["implementation_nodes"]},
    {"required": ["implementation_plan"]}
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "graph_id": {
      "$ref": "#/$defs/slug"
    },
    "graph_version": {
      "type": "integer",
      "minimum": 1
    },
    "context_version": {
      "type": "string",
      "minLength": 1
    },
    "specification_root": {
      "$ref": "#/$defs/relativePath"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "verification_node": {
      "$ref": "#/$defs/slug"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "artifact",
        "targets"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/slug"
        },
        "artifact": {
          "$ref": "#/$defs/nonempty"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "implementation_nodes": {
      "$ref": "#/$defs/implementationNodes"
    },
    "implementation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "path",
        "artifact",
        "implementation_nodes"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/slug"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "artifact": {
          "$ref": "#/$defs/nonempty"
        },
        "implementation_nodes": {
          "$ref": "#/$defs/implementationNodes"
        }
      }
    }
  },
  "$defs": {
    "implementationNodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?=.*\\S).+$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "artifact",
        "producer_node",
        "consumer_nodes",
        "required"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "product",
            "skill",
            "architecture",
            "governance",
            "interface",
            "provider",
            "security",
            "constraints",
            "acceptance",
            "open-questions",
            "research",
            "other"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "artifact": {
          "$ref": "#/$defs/nonempty"
        },
        "producer_node": {
          "$ref": "#/$defs/slug"
        },
        "consumer_nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "source_path",
        "decision_node",
        "artifact",
        "affected_nodes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "deferred"
          ]
        },
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "decision_node": {
          "$ref": "#/$defs/slug"
        },
        "artifact": {
          "$ref": "#/$defs/nonempty"
        },
        "affected_nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    }
  }
}
